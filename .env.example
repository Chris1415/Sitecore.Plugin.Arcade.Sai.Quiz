# Shared leaderboard (optional) — Vercel KV / Upstash Redis REST.
#
# Without these, the leaderboard automatically falls back to per-browser
# localStorage and the game still runs. Set them to make the board GLOBAL.
#
# On Vercel: create a KV store (Storage tab) and connect it to the project —
# Vercel injects KV_REST_API_URL / KV_REST_API_TOKEN automatically. For local
# dev, run `vercel env pull .env.local` to fetch them.
#
# Using a raw Upstash Redis instead? The route also reads UPSTASH_REDIS_REST_URL
# / UPSTASH_REDIS_REST_TOKEN.

KV_REST_API_URL=
KV_REST_API_TOKEN=
